# Database (NeonDB / PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secure secret
NEXTAUTH_SECRET="your_nextauth_secret_key_here"

# Canonical URL of the deployment (e.g. https://uesabroad.com or http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"
