# ==============================================================================
# UES ABROAD PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env in your hosting environment (Vercel, Railway, VPS, etc.):
#   cp .env.example .env
# Fill in your live production secrets before building and launching the platform.

# ==============================================================================
# 1. DATABASE CONFIGURATION (Required)
# ==============================================================================
# Connection string for PostgreSQL 14+ (supports Neon.tech, Supabase, AWS RDS, etc.).
# - Standard Direct Connection:
#   postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# - Neon / Supabase Serverless Connection Pool (Recommended for Vercel/Next.js):
#   Use the pooled connection string on port 6543 with '?sslmode=require'
DATABASE_URL="postgresql://neondb_owner:your_secure_password@ep-example-endpoint.us-east-2.aws.neon.tech/ues_abroad?sslmode=require"

# ==============================================================================
# 2. NEXTAUTH AUTHENTICATION (Required)
# ==============================================================================
# Cryptographic secret used to encrypt and sign JWT session tokens and cookies.
# Generate a secure 32+ character key by running:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_secure_random_base64_string_min_32_chars"

# Canonical production URL of your deployment.
# Used by NextAuth to validate redirect callbacks and secure cookie origins.
# - Production: https://uesabroad.com (or your custom domain)
# - Staging:    https://staging.uesabroad.com
# - Local Dev:  http://localhost:3000
NEXTAUTH_URL="https://uesabroad.com"
NEXT_PUBLIC_APP_URL="https://uesabroad.com"

# ==============================================================================
# 3. INITIAL ADMIN CONSOLE BOOTSTRAP (Recommended)
# ==============================================================================
# Initial credentials used by your deployment team to log into the Admin Console (/admin/login)
# immediately upon provisioning the remote database.
#
# Once logged in, administrators can manage admissions counseling staff, universities,
# courses, blogs, and site settings directly through the UI.
ADMIN_EMAIL="admin@uesabroad.com"
ADMIN_PASSWORD="ChooseAStrongProductionPassword2026!"

# ==============================================================================
# 4. EMAIL SERVICE — RESEND (Transactional & Lead Notifications)
# ==============================================================================
# Purpose:
#   The platform uses Resend (https://resend.com) as its transactional email provider.
#   It powers:
#     1. Instant student lead inquiry alerts to UES Abroad branch counselors (Palakkad & Calicut).
#     2. Free 1-on-1 counseling booking confirmation emails delivered to students with branch details.
#     3. Forex and accommodation referral notifications sent to partner desks.
#
# How to obtain your key:
#   1. Sign up at https://resend.com
#   2. Verify your sending domain (e.g. notifications@uesabroad.com)
#   3. Create an API key under API Keys → "Create API Key" (Format: re_...)
#
# Graceful Fallback Behavior:
#   If RESEND_API_KEY is not set or left as default, all student lead submissions,
#   consultation requests, and forex inquiries are safely saved into the PostgreSQL
#   database and accessible via /admin/leads without throwing runtime errors.
RESEND_API_KEY="re_your_live_resend_api_key_here"
